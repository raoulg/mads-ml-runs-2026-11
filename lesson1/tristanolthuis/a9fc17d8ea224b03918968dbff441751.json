             [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2514\u2500Sequential: 4-2                   [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Linear: 5-5                  [2, 493]                  [2, 493]                  243,542\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Norm: 5-6                    [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500BatchNorm1d: 6-3        [2, 493]                  [2, 493]                  986\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Activation: 5-7              [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500GELU: 6-4               [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Dropout: 5-8                 [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2514\u2500Dense: 3-3                             [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2514\u2500Sequential: 4-3                   [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Linear: 5-9                  [2, 493]                  [2, 493]                  243,542\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Norm: 5-10                   [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500BatchNorm1d: 6-5        [2, 493]                  [2, 493]                  986\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Activation: 5-11             [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500GELU: 6-6               [2, 493]                  [2, 493]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Dropout: 5-12                [2, 493]                  [2, 493]                  --\n\u251c\u2500Linear: 1-3                                      [2, 493]                  [2, 47]                   23,218\n=============================================================================================================================\nTotal params: 703,065\nTrainable params: 703,065\nNon-trainable params: 0\nTotal mult-adds (Units.MEGABYTES): 1.41\n=============================================================================================================================\nInput size (MB): 0.00\nForward/backward pass size (MB): 0.05\nParams size (MB): 2.81\nEstimated Total Size (MB): 2.86\n============================================================================================================================="
