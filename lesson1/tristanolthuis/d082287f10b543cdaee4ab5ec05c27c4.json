               [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2514\u2500Sequential: 4-2                   [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Linear: 5-5                  [2, 819]                  [2, 819]                  671,580\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Norm: 5-6                    [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500BatchNorm1d: 6-3        [2, 819]                  [2, 819]                  1,638\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Activation: 5-7              [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500GELU: 6-4               [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Dropout: 5-8                 [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2514\u2500Dense: 3-3                             [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2514\u2500Sequential: 4-3                   [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Linear: 5-9                  [2, 819]                  [2, 819]                  671,580\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Norm: 5-10                   [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500BatchNorm1d: 6-5        [2, 819]                  [2, 819]                  1,638\n\u2502    \u2502    \u2502    \u2502    \u2514\u2500Activation: 5-11             [2, 819]                  [2, 819]                  --\n\u2502    \u2502    \u2502    \u2502    \u2502    \u2514\u2500GELU: 6-6               [2, 819]                  [2, 819]                 