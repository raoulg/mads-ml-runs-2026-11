   "design.py": "\"\"\"Wai's design for lesson 1: the head of the baseline, and only the encoder changes.\r\n\r\nIn my own words: one step, from the encoder's vector to one score per texture. The\r\ninput width follows the encoder (384 for dinov2-small, 768 for dinov2-base, 1024 for\r\ndinov2-large); the output stays 47 as long as the dataset is DTD. There are no stations\r\nin between, so the head is the same as the baseline, and a difference between trials\r\ncomes from the encoder alone. The encoder is an axis of the trainer (`SPACE` in\r\n`study.py`), not of this design, so this design has no options.\r\n\r\nRead it in atlas before you train anything:\r\n\r\n    atlas-code-nightly view notebooks/1_representation_and_head/exercises\r\n\r\nRun it from the root of the course repository to see the shape after every stage, for\r\nevery encoder of the study:\r\n\r\n    uv run notebooks/1_representation_and_head/exercises/designs.py\r\n\"\"\"\r\n\r\nfrom dataclasses import dataclass\r\n\r\nimport torch\r\nfrom beartype import beartype\r\nfrom jaxtyping import Float, jaxtyped\r\nfrom torch import Tensor, nn\r\nfrom vectormesh.design import Design\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Config:\r\n    \"\"\"The choices of the design: none, the head is fixed. The encoder is chosen by the\r\n    trainer (`\"encoder\"` in `SPACE`).\"\"\"\r\n\r\n\r\nclass Head(nn.Module):\r\n    \"\"\"The linear head of the baseline: one weighted sum per class.\"\"\"\r\n\r\n    def __init__(self, config: Config, dim: int, n_classes: int) -> None:\r\n        super().__init__()\r\n        self.config = config\r\n        self.dim = dim\r\n        self.n_classes = n_classes\r\n        self.classifier = nn.Linear(dim, n_classes)\r\n\r\n    @jaxtyped(typechecker=beartype)\r\n    def classify(\r\n        self, embed: Float[Tensor, \"batch {self.dim}\"]\r\n    ) -> Float[Tensor, \"batch {self.n_classes}\"]:\r\n        return self.classifier(embed)\r\n\r\n    @jaxtyped(typechecker=beartype)\r\n    def forward(\r\n        self, embed: Float[Tensor, \"batch {self.dim}\"]\r\n    ) -> Float[Tensor, \"batch {self.n_classes}\"]:\r\n        return self.classify(embed)\r\n\r\n\r\n# The head and its (empty) config, as the study reads them.\r\nDESIGN = Design(Head, Config)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    # DTD has 47 textures; two rows trace the shapes, once for each encoder's width\r\n    for encoder, width in [\r\n        (\"dinov2-small\", 384),\r\n        (\"dinov2-base\", 768),\r\n        (\"dinov2-large\", 1024),\r\n    ]:\r\n        print(f\"\\n{encoder}:\")\r\n        DESIGN.show(torch.randn(2, width), dim=width, n_classes=47)\r\n"
  },
